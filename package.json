{
  "name": "dispatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check": "tsx scripts/check-migration-inventory.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:synthetic": "tsx --test tests/*.test.ts",
    "diagnose:office-500": "tsx scripts/diagnose-office-dashboard-500.ts",
    "test:staging:e2e": "tsx scripts/test-staging-e2e.ts",
    "release:check": "tsx scripts/release-provenance.ts --check",
    "release:receipt": "tsx scripts/release-provenance.ts --write artifacts/release-provenance.json",
    "test-agent": "npx tsx scripts/test-agent.ts",
    "test:security": "npx tsx scripts/test-security.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "next": "^15.5.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
