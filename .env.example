# Database (Neon Postgres)
DATABASE_URL=

# Session (generate: openssl rand -base64 32)
SESSION_SECRET=some-long-random-32+character-string

# 32-byte base64 key used to encrypt identity secrets (generate with: openssl rand -base64 32)
DISPATCH_IDENTITY_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
