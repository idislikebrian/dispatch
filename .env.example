# Database (Neon Postgres)
DATABASE_URL=

# Session (generate: openssl rand -base64 32)
SESSION_SECRET=some-long-random-32+character-string

# 32-byte base64 key used to encrypt identity secrets (generate with: openssl rand -base64 32)
DISPATCH_IDENTITY_ENCRYPTION_KEY=

# Authorization (see docs/authorization.md). Unset means refused.
DISPATCH_OPERATOR_USER_IDS=
DISPATCH_ENROLLMENT_SECRET=
DISPATCH_AGENT_ENROLLMENT_ENABLED=false
DISPATCH_INTERRUPTS_ENABLED=false

# Non-local database hosts where development/destructive commands are permitted.
# Never list a production host.
DISPATCH_DISPOSABLE_DB_HOSTS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
