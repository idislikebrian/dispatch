generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  workspaces   Workspace[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AuthenticatedIdentity {
  id               String              @id @default(cuid())
  name             String
  keyId            String              @unique
  secretCiphertext String
  active           Boolean             @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  agentId          String?             @unique
  agent            Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  project          Project?
  permissions      Json?
  revokedAt        DateTime?
  rotatedAt        DateTime?
  requestNonces    RequestNonce[]
  idempotencyKeys  IdempotencyRecord[]
  auditEvents      IdentityAuditEvent[]
  enrollmentRequests EnrollmentRequest[]

  @@index([active])
}

model IdentityAuditEvent {
  id         String                @id @default(cuid())
  identityId String
  identity   AuthenticatedIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  action     String
  keyId      String
  metadata   Json?
  createdAt  DateTime              @default(now())

  @@index([identityId, createdAt])
}

model RequestNonce {
  id         String                @id @default(cuid())
  identityId String
  identity   AuthenticatedIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  nonce      String
  expiresAt  DateTime
  createdAt  DateTime              @default(now())

  @@unique([identityId, nonce])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id           String                @id @default(cuid())
  identityId   String
  identity     AuthenticatedIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  key          String
  requestHash  String
  responseCode Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime              @default(now())

  @@unique([identityId, key])
  @@index([expiresAt])
}

model Workspace {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  logEntries LogEntry[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([ownerId])
}

model LogEntry {
  id          String    @id @default(cuid())
  type        String // e.g., "info", "warn", "error"
  message     String
  metadata    Json? // flexible JSON for future data
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([createdAt])
}

model LinearIssueSnapshot {
  id              String   @id @default(cuid())
  identifier      String   @unique
  title           String
  status          String?
  teamKey         String?
  projectName     String?
  priority        Int?
  url             String?
  dueDate         DateTime?
  sourceUpdatedAt DateTime?
  archived        Boolean  @default(false)
  payload         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([sourceUpdatedAt])
}

// ─── Agent Telemetry ────────────────────────────────────────────────────────

enum Project {
  Cobalt
  Caminos
  HIGHER
  Aluminum
  Experimental
  TTABLE
  AYDAF
  DiligentProcrastination
}

model Agent {
  id               String   @id @default(cuid())
  name             String   @unique
  type             String // e.g. "openclaw", "subagent", "cron"
  project          Project?
  isSynthetic      Boolean  @default(false)
  classification   String   @default("unverified")
  classificationEvidence String?
  responsibility   String?
  harness          String?
  objectiveRef     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  heartbeats AgentHeartbeat[]
  events     AgentEvent[]
  costEvents AgentCostEvent[]
  interrupts AgentInterrupt[]
  identity  AuthenticatedIdentity?

  @@index([project])
  @@index([classification])
}

model EnrollmentRequest {
  id                   String                 @id @default(cuid())
  agentName            String
  harness              String
  project              Project?
  requestedPermissions Json
  dedupeKey            String?                @unique
  tokenHash            String                 @unique
  status               String                 @default("pending")
  expiresAt            DateTime
  approvedAt           DateTime?
  consumedAt           DateTime?
  identityId           String?
  identity             AuthenticatedIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())

  @@index([status, expiresAt])
}

model AgentHeartbeat {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status    String // "online", "idle", "offline", "error"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([agentId, createdAt])
}

model AgentEvent {
  id        String          @id @default(cuid())
  agentId   String
  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String // "action", "error", "info", "warning"
  message   String
  project   Project?
  metadata  Json?
  costEvent AgentCostEvent?
  content   ContentItem[]
  createdAt DateTime        @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([project])
}

model AgentCostEvent {
  id           String      @id @default(cuid())
  agentId      String
  agent        Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  eventId      String?     @unique
  event        AgentEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  model        String // e.g. "claude-sonnet-4", "gpt-4o"
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  project      Project?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([project])
}

model AgentInterrupt {
  id             String    @id @default(cuid())
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type           String // "pause", "resume", "stop", "custom"
  message        String?
  status         String    @default("pending") // "pending", "delivered", "acknowledged"
  claimToken     String?   @unique
  claimOwner     String?
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  availableAt    DateTime  @default(now())
  attempts       Int       @default(0)
  acknowledgedAt DateTime?
  deliveryState  String   @default("requested") // requested, delivered, acknowledged, executed, failed, unavailable
  deliveredAt    DateTime?
  executedAt     DateTime?
  failedAt       DateTime?
  failureReason  String?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([agentId])
  @@index([agentId, status])
  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@index([deliveryState])
}

// ─── Content Pipeline ───────────────────────────────────────────────────────

enum ContentPlatform {
  substack
  warpcast
  threads
  bluesky
  youtube
  instagram
  other
}

enum ContentStage {
  idea
  draft
  editing
  scheduled
  published
  repurposed
  archived
}

enum OwnerType {
  human
  agent
}

model ContentItem {
  id             String          @id @default(cuid())
  title          String
  project        Project
  platform       ContentPlatform
  stage          ContentStage
  ownerName      String
  ownerType      OwnerType
  summary        String?
  sourceIdea     String?
  relatedEventId String?
  relatedEvent   AgentEvent?     @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([project])
  @@index([stage])
  @@index([platform])
  @@index([ownerName])
  @@index([createdAt(sort: Desc)])
  @@index([project, stage])
  @@index([relatedEventId])
}
